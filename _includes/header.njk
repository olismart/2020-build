<header>
  <h1>{% if page.url == '/' %}Oli Smart{% else %}<a href="/" title="Home">Oli Smart</a>{% endif %}</h1>
  <p>
    <a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>home</a>
    <a href="/resume.html"{% if page.url == '/resume.html' %} aria-current="page"{% endif %}>resumé</a>
    <a href="/blog/"{% if page.url == '/blog/' %} aria-current="page"{% elif page.url.startsWith('/posts/') %} aria-current="location"{% endif %}>blog</a>
  </p>
  <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Dark mode">
    <span class="thumb" aria-hidden="true">
      <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.5 1.5M17.2 17.2l1.5 1.5M18.7 5.3l-1.5 1.5M6.8 17.2l-1.5 1.5"/></svg>
      <svg class="icon icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </span>
  </button>
</header>
