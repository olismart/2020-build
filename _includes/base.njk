<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="author" content="Oli Smart">
    <meta name="description" content="{{ description or 'Thoughts on product design, UX, and technology.' }}">
    <title>{{ title or 'Blog' }} — Oli Smart</title>
    <link rel="shortcut icon" href="/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="/cv-stylesheet.css" type="text/css">
    <script src="/js/theme.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Recursive:MONO,CASL@1,0.4&display=swap" rel="stylesheet">
  </head>

  <body>
    <div class="wrapper">
      {% include "header.njk" %}
      <main>
        <article{% if date %} class="blog-post"{% endif %}>
          <div class='hero-header'>
            <h2>{{ title }}</h2>
            {% if date %}
              <aside class="post-date">{{ date | postDate }}</aside>
            {% endif %}
          </div>
          <div class="body-text">
            {{ content | safe }}
          </div>
          {% if date %}
            <p><a href="/blog/">← Back to blog</a></p>
          {% endif %}
        </article>
      </main>
    </div>
  </body>
</html>