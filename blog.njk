---
title: Blog
description: Thoughts on product design, UX, and technology.
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="author" content="Oli Smart">
    <meta name="description" content="Thoughts on product design, UX, and technology.">
    <title>Blog — Oli Smart</title>
    <link rel="shortcut icon" href="/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="/cv-stylesheet.css" type="text/css">
    <script src="/js/theme.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap" rel="stylesheet">
  </head>

  <body>
    <div class="wrapper">
      <header>
        <h1><a href="/">Oli Smart</a></h1>
        <p>
          <a href="/">home</a> ⌇
          <a href="/resume.html">resumé</a> ⌇
          <a href="/blog/">blog</a>
        </p>
        <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Dark mode">
          <span class="thumb" aria-hidden="true">
            <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.5 1.5M17.2 17.2l1.5 1.5M18.7 5.3l-1.5 1.5M6.8 17.2l-1.5 1.5"/></svg>
            <svg class="icon icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </span>
        </button>
      </header>
      <main>
        <div class="hero-header">
          <h2>Blog</h2>
          <p class="subtitle">Thoughts on product design, UX, and technology.</p>
        </div>

        <div class="body-text">
          {% if collections.posts.length > 0 %}
            {% for post in collections.posts %}
              <div class="blog-preview">
                <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                {% if post.data.description %}
                  <p>{{ post.data.description }}</p>
                {% endif %}
                <aside>{{ post.date | postDate }}</aside>
              </div>
            {% endfor %}
          {% else %}
            <p>No posts yet — check back soon!</p>
          {% endif %}
        </div>
      </main>
    </div>
  </body>
</html>