---
title: Blog
description: Thoughts on product design, UX, and technology.
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="author" content="Oli Smart">
    <meta name="description" content="Thoughts on product design, UX, and technology.">
    <title>Blog — Oli Smart</title>
    <link rel="shortcut icon" href="/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="/cv-stylesheet.css" type="text/css">
    <script src="/js/theme.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap" rel="stylesheet">
  </head>

  <body>
    <div class="wrapper">
      {% include "header.njk" %}
      <main>
        <div class="hero-header">
          <h2>Blog</h2>
          <p class="subtitle">Thoughts on product design, UX, and technology.</p>
        </div>

        <div class="body-text">
          {% if collections.posts.length > 0 %}
            {% for post in collections.posts %}
              <div class="blog-preview">
                <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                {% if post.data.description %}
                  <p>{{ post.data.description }}</p>
                {% endif %}
                <aside>{{ post.date | postDate }}</aside>
              </div>
            {% endfor %}
          {% else %}
            <p>No posts yet — check back soon!</p>
          {% endif %}
        </div>
      </main>
    </div>
  </body>
</html>